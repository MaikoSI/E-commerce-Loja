{
  // Workspace do VS Code: abra este arquivo (Arquivo > Abrir Workspace a partir do Arquivo)
  // para ver a Loja, o Dashboard e os arquivos compartilhados como pastas separadas.
  "folders": [
    { "name": "Loja (site)", "path": "Loja" },
    { "name": "Dashboard (painel)", "path": "Dashboard" },
    { "name": "Compartilhado (dados e ícone)", "path": "Compartilhado" },
    { "name": "Projeto (README, docs, página inicial)", "path": "." }
  ],

  "settings": {
    // Na pasta "Projeto" esconde Loja/Dashboard/Compartilhado, que já aparecem como pastas próprias
    "files.exclude": {
      "Loja": true,
      "Dashboard": true,
      "Compartilhado": true
    },
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    // Sem formatação automática: o código do Dashboard é compacto de propósito e seria todo reescrito
    "editor.formatOnSave": false,
    "search.exclude": {
      "docs/prints": true
    },
    "git.openRepositoryInParentFolders": "always"
  },

  "extensions": {
    "recommendations": [
      // Mostra o diagrama Mermaid do README na pré-visualização do Markdown
      "bierner.markdown-mermaid"
    ]
  },

  // Terminal > Executar Tarefa...
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Rodar site local",
        "detail": "Servidor em http://localhost:8000 (Loja e Dashboard juntos, compartilhando os dados)",
        "type": "shell",
        "command": "python3 -u -m http.server 8000",
        "options": { "cwd": "${workspaceFolder:Projeto (README, docs, página inicial)}" },
        "isBackground": true,
        "problemMatcher": {
          "owner": "servidor",
          "pattern": { "regexp": "^__nunca__$" },
          "background": { "activeBegins": true, "beginsPattern": "Serving HTTP", "endsPattern": "Serving HTTP" }
        },
        "presentation": { "reveal": "always", "panel": "dedicated" }
      },
      {
        "label": "Abrir Loja",
        "type": "shell",
        "command": "xdg-open http://localhost:8000/Loja/",
        "dependsOn": "Rodar site local",
        "problemMatcher": [],
        "presentation": { "reveal": "silent" }
      },
      {
        "label": "Abrir Dashboard",
        "type": "shell",
        "command": "xdg-open http://localhost:8000/Dashboard/",
        "dependsOn": "Rodar site local",
        "problemMatcher": [],
        "presentation": { "reveal": "silent" }
      },
      {
        "label": "Abrir Loja e Dashboard",
        "type": "shell",
        "command": "xdg-open http://localhost:8000/Loja/ && xdg-open http://localhost:8000/Dashboard/",
        "dependsOn": "Rodar site local",
        "problemMatcher": [],
        "presentation": { "reveal": "silent" },
        "group": { "kind": "build", "isDefault": true }
      },
      {
        "label": "Abrir site publicado",
        "detail": "Versão no GitHub Pages (a que o professor vê)",
        "type": "shell",
        "command": "xdg-open https://maikosi.github.io/E-commerce-Loja/",
        "problemMatcher": [],
        "presentation": { "reveal": "silent" }
      }
    ]
  }
}
